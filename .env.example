# ==============================================================================
# EVENT TRACK MANAGER - CONFIGURATION TEMPLATE
# ==============================================================================
# You can use full Google URLs (copied directly from your browser) OR raw IDs.
# The application automatically extracts the ID from any valid Google URL.

# ------------------------------------------------------------------------------
# 1. Event Branding & Metadata
# ------------------------------------------------------------------------------
APP_TITLE="EMA Paattukoottam"
APP_SUBTITLE="Musical Night • Track Submission"
EVENT_ID="paattukoottam-2026"
EVENT_START_TIME="09-28-2026 06:30PM"
PORT=8088

# ------------------------------------------------------------------------------
# 2. Google Workspace & Drive Links
# ------------------------------------------------------------------------------
# Target Google Sheet (Copy-paste the full URL from your browser or provide ID)
# e.g. https://docs.google.com/spreadsheets/d/1bRvoj4ZlAmSRz972uhTDMfXlYgksH-BOH-zmygp5YRQ/edit
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/1bRvoj4ZlAmSRz972uhTDMfXlYgksH-BOH-zmygp5YRQ/edit"
SHEET_TAB_NAME="Song Sign-Up"

# Active Backing Tracks Shared Drive Folder (Copy-paste full URL or ID)
# e.g. https://drive.google.com/drive/folders/1FQ1goCkaSajLjGv8Yt_vrWTS6krmZufW
GOOGLE_DRIVE_ACTIVE_FOLDER="https://drive.google.com/drive/folders/1FQ1goCkaSajLjGv8Yt_vrWTS6krmZufW"

# Archive Backing Tracks Shared Drive Folder (Copy-paste full URL or ID)
# e.g. https://drive.google.com/drive/folders/1T6zqI02lKQfLfqpPRjQOhn561uUEKDil
GOOGLE_DRIVE_ARCHIVE_FOLDER="https://drive.google.com/drive/folders/1T6zqI02lKQfLfqpPRjQOhn561uUEKDil"

# Path to Google Cloud Service Account JSON Key (or mount into ./secrets/)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH="./secrets/credentials.json"
# Optional: Paste raw JSON content here for cloud deployments without mounted files:
# GOOGLE_SERVICE_ACCOUNT_JSON=""

# ------------------------------------------------------------------------------
# 3. Dynamic Column Header Names
# ------------------------------------------------------------------------------
# The app reads Row 1 of the spreadsheet and dynamically matches each column
# by name. This ensures that even if you re-order columns in your Google Sheet,
# the app continues to work without breaking!
COL_PERFORMER_NAME="Singer (1)"
COL_PARTNER_NAME="Singer (2)"
COL_PERFORMANCE_TYPE="Solo/Duet/Group"
COL_SEQUENCE="Sequence"
COL_SONG_TITLE="Song Name"
COL_MOVIE_NAME="Movie/Album Name"
COL_PERFORMANCE_STATUS="Performance Status"
COL_TRACK_STATUS="Track Uploaded"
COL_DURATION="Duration (Minutes)"
COL_DRIVE_FILE_ID="Drive File ID"
COL_LAST_UPDATED="Last Updated"

# ------------------------------------------------------------------------------
# 4. Security & Storage Settings
# ------------------------------------------------------------------------------
# PIN code required to access the Stage Sound Console (/console)
ADMIN_PIN="2026"

# Maximum upload file size in Megabytes (MB)
MAX_UPLOAD_SIZE_MB=200

# Set to true for offline testing without Google API connection
MOCK_GOOGLE_API=false
