# ==============================================================================
# EVENT TRACK MANAGER - CONFIGURATION TEMPLATE
# Nothing here is required: the app runs with defaults. No cloud accounts or API keys are needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Event identity (also editable later in /admin; first boot seeds from here)
# ------------------------------------------------------------------------------
EVENT_ID="paattukoottam-2026"        # becomes the folder name: ./events/<EVENT_ID>/
APP_TITLE="Paattukoottam Sing & Serenade"
APP_SUBTITLE="Musical Night • September 19, 2026"
EVENT_START_TIME="09-19-2026 05:00PM"
EVENT_TIMEZONE="America/New_York"
EVENT_VENUE="1 Scouting Wy, Exton, PA 19341, USA"
EVENT_TIME_RANGE="5:00 PM - 9:00 PM EDT"
ENTRY_ID_PREFIX="PK"                  # entry ids like PK-001 (also appear in track file names)
PORT=8088

# ------------------------------------------------------------------------------
# 2. Security
# ------------------------------------------------------------------------------
ADMIN_PIN="2026"                      # CHANGE THIS. Protects /console and /admin

# ------------------------------------------------------------------------------
# 3. Storage (all optional)
# ------------------------------------------------------------------------------
# EVENTS_DIR=/events                  # parent folder of all events (Docker default)
# EVENT_DIR=/some/folder              # or pin one explicit event folder
MAX_UPLOAD_SIZE_MB=200
AUDIO_BITRATE="320k"

# ------------------------------------------------------------------------------
# 4. Optional cloud sync sidecar (see rclone/README.md). Start with: docker compose --profile sync up -d
# ------------------------------------------------------------------------------
# RCLONE_REMOTE=gdrive:EventTrackManager/paattukoottam-2026
# RCLONE_TRASH=gdrive:EventTrackManager/_trash/paattukoottam-2026
# SYNC_INTERVAL=30

# ------------------------------------------------------------------------------
# 5. Behaviour defaults (editable in /admin after first boot)
# ------------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DEBOUNCE_SECONDS=10
FOOD_SIGNUP_ENABLED=true
FOOD_SERVING_NOTE="Half-Tray or Above (15+ servings)"
LIVE_ORDER_BY="readiness,sequence"
CONSOLE_EXTRA_COLUMNS="Age Group"

# ------------------------------------------------------------------------------
# 6. YouTube downloader (yt-dlp updates itself, no rebuild needed)
# ------------------------------------------------------------------------------
# YTDLP_AUTO_UPDATE=true
# YTDLP_UPDATE_HOURS=24
# Optional cookies (helps with YouTube "confirm you're not a bot"): save a cookies.txt export as secrets/yt_cookies.txt
